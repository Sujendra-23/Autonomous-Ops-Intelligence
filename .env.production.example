# Copy to .env.production, chmod 600, and replace every placeholder. Do not commit secrets.
ENVIRONMENT=production
AUTH_MODE=oidc
AUTH_ISSUER=https://YOUR-IDENTITY-PROVIDER/
AUTH_AUDIENCE=YOUR-API-AUDIENCE
AUTH_JWKS_URL=https://YOUR-IDENTITY-PROVIDER/.well-known/jwks.json
VITE_AUTH_AUTHORITY=https://YOUR-IDENTITY-PROVIDER/
VITE_AUTH_CLIENT_ID=YOUR-PUBLIC-PKCE-CLIENT-ID
VITE_AUTH_PROVIDER_NAME=Company SSO
VITE_AUTH_SCOPE=openid profile email
# Auth0/custom authorization server only; API audience validation stays in AUTH_AUDIENCE.
# Entra: leave this blank and add your exposed AOI API scope to VITE_AUTH_SCOPE.
VITE_AUTH_AUDIENCE=
CORS_ORIGINS=https://YOUR-APP-DOMAIN
# Runtime role MUST be NOSUPERUSER NOBYPASSRLS; migration role is separate.
DATABASE_URL=postgresql+asyncpg://aoi_runtime:REPLACE@YOUR-POSTGRES:5432/aoi
MIGRATION_DATABASE_URL=postgresql+asyncpg://aoi_migration:REPLACE@YOUR-POSTGRES:5432/aoi
REDIS_URL=rediss://default:REPLACE@YOUR-REDIS:6379/0
# Generate with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
CONNECTOR_ENCRYPTION_KEY=REPLACE-WITH-FERNET-KEY
# Comma-separated exact public destination hosts for generic webhooks; empty disables them.
CONNECTOR_ALLOWED_WEBHOOK_HOSTS=
REQUEST_LIMIT_PER_MINUTE=120
PAID_OPERATIONS_PER_DAY=100
PLATFORM_PAID_OPERATIONS_PER_DAY=1000
MAX_REQUEST_BYTES=104857600
LIVE_SESSION_MAX_SECONDS=7200
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
STT_PROVIDER=none
LIVE_TRANSCRIPTION_LANGUAGE=auto
DEEPGRAM_API_KEY=

# OAuth provider app registrations. Callback paths are listed in docs/connector-oauth.md.
CONNECTOR_OAUTH_REDIRECT_BASE=https://YOUR-APP-DOMAIN
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
TEAMS_CLIENT_ID=
TEAMS_CLIENT_SECRET=
TEAMS_TENANT_ID=organizations

# Required for metrics in OIDC/staging/production. Mount a matching token file
# into Prometheus and enable authorization on both API and worker scrape jobs.
METRICS_TOKEN=

# In-app AOI meetings and huddles. Use LiveKit Cloud or a deployed LiveKit server.
# Secrets stay on the backend. Local development uses compose.calls.yml instead.
LIVEKIT_URL=
LIVEKIT_API_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
APP_PUBLIC_URL=https://your-aoi-domain.example
