# Copy to .env.production, chmod 600, and replace every placeholder. Do not commit secrets.
ENVIRONMENT=production
AUTH_MODE=oidc
AUTH_ISSUER=https://YOUR-IDENTITY-PROVIDER/
AUTH_AUDIENCE=YOUR-API-AUDIENCE
AUTH_JWKS_URL=https://YOUR-IDENTITY-PROVIDER/.well-known/jwks.json
VITE_AUTH_AUTHORITY=https://YOUR-IDENTITY-PROVIDER/
VITE_AUTH_CLIENT_ID=YOUR-PUBLIC-PKCE-CLIENT-ID
CORS_ORIGINS=https://YOUR-APP-DOMAIN
# Runtime role MUST be NOSUPERUSER NOBYPASSRLS; migration role is separate.
DATABASE_URL=postgresql+asyncpg://aoi_runtime:REPLACE@YOUR-POSTGRES:5432/aoi
MIGRATION_DATABASE_URL=postgresql+asyncpg://aoi_migration:REPLACE@YOUR-POSTGRES:5432/aoi
REDIS_URL=rediss://default:REPLACE@YOUR-REDIS:6379/0
# Generate with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
CONNECTOR_ENCRYPTION_KEY=REPLACE-WITH-FERNET-KEY
# Comma-separated exact public destination hosts for generic webhooks; empty disables them.
CONNECTOR_ALLOWED_WEBHOOK_HOSTS=
REQUEST_LIMIT_PER_MINUTE=120
PAID_OPERATIONS_PER_DAY=100
PLATFORM_PAID_OPERATIONS_PER_DAY=1000
MAX_REQUEST_BYTES=104857600
LIVE_SESSION_MAX_SECONDS=7200
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
STT_PROVIDER=none
DEEPGRAM_API_KEY=
