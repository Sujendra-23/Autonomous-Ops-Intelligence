{
  "uid": "aoi-llm-observability",
  "title": "AOI LLM and Extraction Observability",
  "tags": [
    "aoi",
    "llm"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "LLM calls / min",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "aoi-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "aoi-prometheus"
          },
          "expr": "sum(rate(aoi_llm_requests_total[$__rate_interval])) * 60",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "LLM failure ratio",
      "description": "Provider errors plus responses that failed JSON or schema validation, over all LLM calls.",
      "datasource": {
        "type": "prometheus",
        "uid": "aoi-prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "aoi-prometheus"
          },
          "expr": "sum(rate(aoi_llm_requests_total{outcome!=\"success\"}[$__rate_interval])) / sum(rate(aoi_llm_requests_total[$__rate_interval]))",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.02
              },
              {
                "color": "red",
                "value": 0.1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "LLM latency p95",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "aoi-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "aoi-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(aoi_llm_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 10
              },
              {
                "color": "red",
                "value": 30
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Tokens / min",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "aoi-prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "aoi-prometheus"
          },
          "expr": "sum(rate(aoi_llm_tokens_total[$__rate_interval])) * 60",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "LLM calls by outcome",
      "description": "outcome is success, error (provider failure), or invalid_output (unparseable or schema-violating response).",
      "datasource": {
        "type": "prometheus",
        "uid": "aoi-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "aoi-prometheus"
          },
          "expr": "sum by (operation, outcome) (rate(aoi_llm_requests_total[$__rate_interval]))",
          "legendFormat": "{{operation}} / {{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "LLM latency percentiles",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "aoi-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "aoi-prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le, operation) (rate(aoi_llm_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50 {{operation}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "aoi-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(aoi_llm_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95 {{operation}}",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "aoi-prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le, operation) (rate(aoi_llm_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p99 {{operation}}",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Token usage by direction",
      "description": "Tokens per minute as reported by the provider.",
      "datasource": {
        "type": "prometheus",
        "uid": "aoi-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "aoi-prometheus"
          },
          "expr": "sum by (direction) (rate(aoi_llm_tokens_total[$__rate_interval])) * 60",
          "legendFormat": "{{direction}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Token usage by model and operation",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "aoi-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "aoi-prometheus"
          },
          "expr": "sum by (model, operation) (rate(aoi_llm_tokens_total[$__rate_interval])) * 60",
          "legendFormat": "{{model}} / {{operation}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Extractions by outcome",
      "description": "mode full is a finished transcript. mode live is an incremental pass during a live meeting.",
      "datasource": {
        "type": "prometheus",
        "uid": "aoi-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "aoi-prometheus"
          },
          "expr": "sum by (mode, outcome) (rate(aoi_extractions_total[$__rate_interval])) * 60",
          "legendFormat": "{{mode}} / {{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Extraction failures by reason",
      "description": "llm_error is a provider failure or invalid model output. pipeline_error is anything else in the pipeline.",
      "datasource": {
        "type": "prometheus",
        "uid": "aoi-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 20,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "aoi-prometheus"
          },
          "expr": "sum by (reason) (increase(aoi_extractions_total{outcome=\"failed\"}[$__rate_interval]))",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Extraction failure ratio (full)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "aoi-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 20,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "aoi-prometheus"
          },
          "expr": "sum(rate(aoi_extractions_total{mode=\"full\",outcome=\"failed\"}[$__rate_interval])) / sum(rate(aoi_extractions_total{mode=\"full\"}[$__rate_interval]))",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 1,
