# Copy to .env.identity (gitignored) and replace these placeholders.
# Use URL-safe random values, e.g. openssl rand -hex 32, for each secret.
IDENTITY_POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
IDENTITY_APP_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_HEX
IDENTITY_REDIS_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_HEX
IDENTITY_BOOTSTRAP_KEY=REPLACE_WITH_DIFFERENT_RANDOM_HEX
IDENTITY_PORT=8180
# Required only when enabling compose.company.yml. Provision a restricted AOI
# role first and use its URL; never use the PostgreSQL bootstrap role here.
# AOI_RUNTIME_DATABASE_URL=postgresql+asyncpg://aoi_runtime:<url-encoded-password>@postgres:5432/aoi
# CONNECTOR_ENCRYPTION_KEY=<retained-Fernet-key>
